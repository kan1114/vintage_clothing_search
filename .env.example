# 秘密情報はここ（.env）に書く。.env は .gitignore 済みなのでコミットされません。

# Claude API（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# LINE Messaging API（LINE Developers コンソールで発行）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=

# eBay Browse API（https://developer.ebay.com で発行）
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# Instagram Graph API（Meta for Developers）
IG_ACCESS_TOKEN=
IG_USER_ID=
