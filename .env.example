# 秘密情報。.env は .gitignore 済み。エージェントは .env を読めない（権限で拒否）ので、
# 実行前にシェルへ読み込む: set -a; source .env; set +a

# Claude Code の認証（どちらか一方）
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=   # `claude setup-token` で発行（サブスクリプション利用）

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=

# eBay Browse API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Instagram Graph API
IG_ACCESS_TOKEN=
IG_USER_ID=
