{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Agent",
      "Read",
      "Glob",
      "Grep",
      "Write(./data/**)",
      "Edit(./data/**)",
      "Bash(curl *)",
      "Bash(scripts/*.sh *)",
      "Bash(jq *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(tr *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(date *)",
      "Bash(mkdir -p data/*)",
      "Bash(tee data/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(rm *)",
      "Bash(git *)"
    ]
  }
}
